# At least one provider key is required. With both, routing can fall back across providers.
OPENAI_API_KEY=
GEMINI_API_KEY=

# heuristic | llm | hybrid
CLASSIFIER_MODE=hybrid
# Hybrid: if heuristic confidence is below this, ask a cheap LLM to classify
CONFIDENCE_THRESHOLD=0.7

REQUEST_TIMEOUT_S=30
MAX_RETRIES_PER_MODEL=1
RETRY_BACKOFF_S=0.5
BREAKER_FAILURE_THRESHOLD=3
BREAKER_COOLDOWN_S=30

# Optional: override the model ladder (JSON). tier 0=fast/cheap, 1=balanced, 2=strongest.
# MODELS=[{"name":"gpt-4o-mini","provider":"openai","tier":0,"input_per_m":0.15,"output_per_m":0.6}]
